% Beamer theme "India2047": golden-ratio layout, evidence footers, reader's notes.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeIndia2047}[2026/11/15]

\RequirePackage[T1]{fontenc}
\RequirePackage[sfdefault,lining]{FiraSans}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta,backgrounds,fit,decorations.pathreplacing}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{ragged2e}

