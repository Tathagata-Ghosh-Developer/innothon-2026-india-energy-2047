# Render the landing page from the model's summary (CMake script mode):
#   cmake -DSUMMARY=outputs/site_summary.json -DTEMPLATE=web/landing.html -DOUT=<dir>/index.html -P cmake/Site.cmake
# outputs/site_summary.json is written by energy2047 (apps/energy2047.cpp, write_site_summary),
# so no number on the page is typed by hand. The result is static HTML: it needs no
# JavaScript, no fetch and no WebAssembly.
#
# Template syntax (web/landing.html):
#   {{a.b.0.c}}       value at that JSON path (object keys and array indices separated by dots)
#   {{a.b|N}}         number rounded to N decimals (0-3), thousands separators, minus sign U+2212
#   {{a.b|+N}}        the same with an explicit + for positive values
#   {{a.b|aN}}        absolute value, N decimals
#   {{a.b|rN}}        rounded, plain ASCII (for SVG and CSS values)
#   {{len a.b}}       number of elements of an array
#   <!--each a.b-->...<!--/each-->          the block once per element of array a.b
#   <!--each-reverse a.b-->...<!--/each-->  the same, last element first
#     inside a block: {{@.c}} is field c of the element, {{@}} the element itself,
#     {{@i}} its index (from 0) and {{@i|*K}} the index times an integer K.
# Every value is HTML-escaped. A missing key stops the build.
cmake_minimum_required(VERSION 3.26)

foreach(_v SUMMARY TEMPLATE OUT)
  if(NOT DEFINED ${_v})
    message(FATAL_ERROR "Site.cmake: pass -D${_v}=<path>")
  endif()
endforeach()
if(NOT EXISTS "${SUMMARY}")
  message(FATAL_ERROR "site: ${SUMMARY} not found.\n"
    "Run the command-line model once (native build, see README.md):\n"
    "  energy2047 \"<repo root>\"\n"
    "It writes outputs/site_summary.json; then build the site again.")
endif()
file(READ "${SUMMARY}" _json)
file(READ "${TEMPLATE}" _html)
string(JSON _schema ERROR_VARIABLE _err GET "${_json}" schema)
if(NOT _err STREQUAL "NOTFOUND" OR NOT _schema EQUAL 1)
  message(FATAL_ERROR "site: ${SUMMARY} is not a schema-1 site summary (${_err})")
endif()

# _site_format(<out> <number> <spec>): see the template syntax above.
function(_site_format out value spec)
  if(NOT spec MATCHES "^([+ar]?)([0-3])$")
    message(FATAL_ERROR "site: unknown number format '|${spec}'")
  endif()
  set(_mode "${CMAKE_MATCH_1}")
  set(_dec ${CMAKE_MATCH_2})
  if(NOT value MATCHES "^(-?)([0-9]+)(\\.([0-9]*))?$")
    message(FATAL_ERROR "site: '${value}' is not a plain number")
  endif()
  set(_neg "${CMAKE_MATCH_1}")
  set(_int "${CMAKE_MATCH_2}")
  set(_frac "${CMAKE_MATCH_4}0000")
  # Round half up on the absolute value, in integer units of 10^-dec.
  string(SUBSTRING "${_frac}" 0 ${_dec} _keep)
  string(SUBSTRING "${_frac}" ${_dec} 1 _next)
  # Strip leading zeros one at a time: CMake's REGEX REPLACE applies "^" again after
  # every match, so "^0+([0-9])" would also eat zeros inside the number ("0103" -> "13").
  set(_scaled "${_int}${_keep}")
  while(_scaled MATCHES "^0[0-9]")
    string(SUBSTRING "${_scaled}" 1 -1 _scaled)
  endwhile()
  if(_next GREATER_EQUAL 5)
    math(EXPR _scaled "${_scaled} + 1")
  endif()
  if(_dec GREATER 0)
    string(LENGTH "${_scaled}" _len)
    while(_len LESS_EQUAL _dec)
      string(PREPEND _scaled "0")
      math(EXPR _len "${_len} + 1")
    endwhile()
    math(EXPR _cut "${_len} - ${_dec}")
    string(SUBSTRING "${_scaled}" 0 ${_cut} _int)
    string(SUBSTRING "${_scaled}" ${_cut} -1 _frac)
    set(_frac ".${_frac}")
  else()
    set(_int "${_scaled}")
    set(_frac "")
  endif()
  set(_zero FALSE)
  if(_int MATCHES "^0*$" AND _frac MATCHES "^\\.?0*$")
    set(_zero TRUE)
  endif()
  if(NOT _mode STREQUAL "r")
    set(_prev "")
    while(NOT _prev STREQUAL _int)
      set(_prev "${_int}")
      string(REGEX REPLACE "([0-9])([0-9][0-9][0-9])($|,)" "\\1,\\2\\3" _int "${_int}")
    endwhile()
  endif()
  set(_sign "")
  if(_mode STREQUAL "r")
    if(_neg AND NOT _zero)
      set(_sign "-")
    endif()
  elseif(_mode STREQUAL "a" OR _zero)
    set(_sign "")
  elseif(_neg)
    set(_sign "−")
  elseif(_mode STREQUAL "+")
    set(_sign "+")
  endif()
  set(${out} "${_sign}${_int}${_frac}" PARENT_SCOPE)
endfunction()

# _site_eval(<out> <expression inside {{ }}>)
function(_site_eval out expr)
  set(_spec "")
  if(expr MATCHES "^([^|]*)\\|(.*)$")
    set(expr "${CMAKE_MATCH_1}")
    set(_spec "${CMAKE_MATCH_2}")
  endif()
  set(_err "NOTFOUND")
  set(_path "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$")
  if(expr MATCHES "^len (.+)$")
    set(_target "${CMAKE_MATCH_1}")
  else()
    set(_target "${expr}")
  endif()
  if(NOT _target MATCHES "${_path}")
    message(FATAL_ERROR "site: '{{${expr}}}' is not a JSON path (keys and indices separated by dots)")
  endif()
  if(expr MATCHES "^[0-9]+$")
    set(_v "${expr}")  # an expanded {{@i}}
  elseif(expr MATCHES "^len (.+)$")
    string(REPLACE "." ";" _p "${CMAKE_MATCH_1}")
    string(JSON _v ERROR_VARIABLE _err LENGTH "${_json}" ${_p})
  else()
    string(REPLACE "." ";" _p "${expr}")
    string(JSON _v ERROR_VARIABLE _err GET "${_json}" ${_p})
  endif()
  if(NOT _err STREQUAL "NOTFOUND")
    message(FATAL_ERROR "site: {{${expr}}}: ${_err} in ${SUMMARY}")
  endif()
  if(_spec MATCHES "^\\*([0-9]+)$")
    math(EXPR _v "${_v} * ${CMAKE_MATCH_1}")
  elseif(NOT _spec STREQUAL "")
    _site_format(_v "${_v}" "${_spec}")
  endif()
  set(${out} "${_v}" PARENT_SCOPE)
endfunction()

# Expand <!--each ...--> blocks (not nested).
set(_out "")
set(_rest "${_html}")
while(TRUE)
  string(FIND "${_rest}" "<!--each" _p)
  if(_p EQUAL -1)
    break()
  endif()
  string(SUBSTRING "${_rest}" 0 ${_p} _head)
  string(APPEND _out "${_head}")
  string(SUBSTRING "${_rest}" ${_p} -1 _rest)
  string(FIND "${_rest}" "-->" _q)
  math(EXPR _q "${_q} + 3")
  string(SUBSTRING "${_rest}" 0 ${_q} _tag)
  string(SUBSTRING "${_rest}" ${_q} -1 _rest)
  if(NOT _tag MATCHES "^<!--each(-reverse)? ([A-Za-z0-9_.]+)-->$")
    message(FATAL_ERROR "site: malformed block tag ${_tag}")
  endif()
  set(_reverse "${CMAKE_MATCH_1}")
  set(_path "${CMAKE_MATCH_2}")
  string(FIND "${_rest}" "<!--/each-->" _e)
  if(_e EQUAL -1)
    message(FATAL_ERROR "site: ${_tag} has no <!--/each-->")
  endif()
  string(SUBSTRING "${_rest}" 0 ${_e} _body)
  math(EXPR _e "${_e} + 12")
  string(SUBSTRING "${_rest}" ${_e} -1 _rest)
  string(REPLACE "." ";" _parts "${_path}")
  string(JSON _n ERROR_VARIABLE _err LENGTH "${_json}" ${_parts})
  if(NOT _err STREQUAL "NOTFOUND")
    message(FATAL_ERROR "site: ${_tag}: ${_err}")
  endif()
  if(_n GREATER 0)
    math(EXPR _last "${_n} - 1")
    foreach(_k RANGE ${_last})
      set(_i ${_k})
      if(_reverse)
        math(EXPR _i "${_last} - ${_k}")
      endif()
      string(REPLACE "{{@i" "{{${_i}" _b "${_body}")
      string(REPLACE "{{@" "{{${_path}.${_i}" _b "${_b}")
      string(APPEND _out "${_b}")
    endforeach()
  endif()
endwhile()
string(APPEND _out "${_rest}")
set(_html "${_out}")

# Substitute {{...}} values.
string(REGEX MATCHALL "{{[^{}]+}}" _tokens "${_html}")
list(REMOVE_DUPLICATES _tokens)
foreach(_t IN LISTS _tokens)
  string(LENGTH "${_t}" _len)
  math(EXPR _len "${_len} - 4")
  string(SUBSTRING "${_t}" 2 ${_len} _expr)
  _site_eval(_v "${_expr}")
  string(REPLACE "&" "&amp;" _v "${_v}")
  string(REPLACE "<" "&lt;" _v "${_v}")
  string(REPLACE ">" "&gt;" _v "${_v}")
  string(REPLACE "\"" "&quot;" _v "${_v}")
  string(REPLACE "${_t}" "${_v}" _html "${_html}")
endforeach()
string(FIND "${_html}" "{{" _left)
if(NOT _left EQUAL -1)
  string(SUBSTRING "${_html}" ${_left} 60 _ctx)
  message(FATAL_ERROR "site: unexpanded template text near: ${_ctx}")
endif()

get_filename_component(_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_dir}")
file(WRITE "${OUT}" "${_html}")
list(LENGTH _tokens _nt)
message(STATUS "site: ${OUT} (${_nt} values from ${SUMMARY})")
