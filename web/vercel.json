{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/app", "status": 307, "headers": { "Location": "/app/" } },
    {
      "src": "/(.*)",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin",
        "X-Content-Type-Options": "nosniff",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(robots\\.txt|llms\\.txt|sitemap\\.xml|og-image\\.png)",
      "headers": { "Cross-Origin-Resource-Policy": "cross-origin" },
      "continue": true
    },
    { "src": "/(.*)\\.wasm", "headers": { "Content-Type": "application/wasm" }, "continue": true },
    { "src": "/(.*)\\.data", "headers": { "Content-Type": "application/octet-stream" }, "continue": true },
    { "src": "/(.*)\\.md", "headers": { "Content-Type": "text/markdown; charset=utf-8" }, "continue": true },
    { "src": "/llms\\.txt", "headers": { "Content-Type": "text/plain; charset=utf-8" }, "continue": true },
    { "src": "/(about|contact|privacy)/?", "dest": "/$1.html" },
    {
      "src": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" },
      "dest": "/index.md"
    },
    { "src": "/", "headers": { "Vary": "Accept" }, "continue": true },
    { "handle": "error" },
    {
      "src": "/.*",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "status": 404,
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" },
      "dest": "/404.md"
    },
    { "src": "/.*", "status": 404, "headers": { "Vary": "Accept" }, "dest": "/404.html" }
  ]
}
